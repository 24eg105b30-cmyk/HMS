# ========================================================
# MongoDB Atlas Configuration Example
# Hospital Management System
# ========================================================

# 1. Sign in to MongoDB Atlas (https://cloud.mongodb.com)
# 2. In "Database Access", create a database user (e.g., hms_user) with readWriteAnyDatabase permission.
# 3. In "Network Access", add IP address: 0.0.0.0/0 (allow access from anywhere for development).
# 4. In "Database" -> Click "Connect" -> Drivers -> Copy standard connection string.
# 5. Make sure the database name is "hospital_management".

# Connection String Format:
# mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER-NAME>.mongodb.net/hospital_management?retryWrites=true&w=majority

# On Windows PowerShell:
# $env:MONGODB_URI="mongodb+srv://hms_user:YourSecretPassword123@cluster0.abcde.mongodb.net/hospital_management?retryWrites=true&w=majority"

# On Windows Command Prompt (cmd):
# set MONGODB_URI=mongodb+srv://hms_user:YourSecretPassword123@cluster0.abcde.mongodb.net/hospital_management?retryWrites=true&w=majority

MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/hospital_management?retryWrites=true&w=majority
